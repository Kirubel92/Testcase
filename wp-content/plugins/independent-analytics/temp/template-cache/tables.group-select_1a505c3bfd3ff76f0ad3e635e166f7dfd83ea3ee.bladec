<?php /** @var \IAWP\Tables\Groups\Groups $groups */  ?>
<?php /** @var \IAWP\Tables\Groups\Group $current_group */  ?>

<?php if($groups->has_grouping_options()): ?>
 <div class="group-select-container">
 <select id="group-select"
 class="group-select"
 data-controller="group"
 data-action="group#changeGroup"
 >
 <?php $__currentLoopData = $groups->groups(); $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $group): $loop = $this->incrementLoopIndices();  ?>
 <option id="<?php echo \htmlentities(esc_attr($group->id())??'', ENT_QUOTES, 'UTF-8', false); ?>"
 value="<?php echo \htmlentities(esc_attr($group->id())??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-testid="group-by-<?php echo \htmlentities(esc_attr($group->id())??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php echo \htmlentities(selected($group->id(), $current_group->id(), true)??'', ENT_QUOTES, 'UTF-8', false); ?>

 >
 <?php echo \htmlentities(esc_html($group->singular())??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 <label><span class="dashicons dashicons-open-folder"></span></label>
 </div>
<?php endif; ?>